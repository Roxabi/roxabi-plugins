{
  "enabledPlugins": {
    "dev-core@roxabi-marketplace": true,
    "compress@roxabi-marketplace": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "roxabi-marketplace": {
      "source": {
        "source": "github",
        "repo": "Roxabi/roxabi-plugins"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "", "hooks": [
        { "type": "command",
          "command": "command -v bun >/dev/null 2>&1 || { echo 'SKIP: R3 typecheck (bun not found)' >&2; exit 0; }; bun run typecheck || echo 'R3 DRIFT: typecheck failed' >&2" }
      ] }
    ]
  }
}
