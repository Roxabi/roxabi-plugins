{
  "name": "extern-client-metalyde",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "mailpit:start": "bash scripts/mailpit-start.sh",
    "mailpit:stop": "bash scripts/mailpit-stop.sh",
    "mailpit:status": "bash scripts/mailpit-status.sh",
    "mailpit:logs": "bash scripts/mailpit-logs.sh",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "bash tools/sync-quality-gates.sh && (git rev-parse --is-inside-work-tree >/dev/null 2>&1 && lefthook install || true)",
    "setup": "./scripts/setup.sh",
    "db:generate": "bash scripts/db.generate.sh",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:users": "npm run seed:demo",
    "typecheck": "tsc --noEmit",
    "quality-gates:sync": "bash tools/sync-quality-gates.sh",
    "quality-gates:check": "bash tools/sync-quality-gates.sh --check && QG_FILE_MODE=tree bash tools/check_file_length.sh && bash tools/check_mock_sut.sh && bash tools/check_bare_req_json.sh",
    "seed:demo": "npx tsx scripts/seed-demo.ts",
    "backfill:image-thumbs": "npx tsx scripts/backfill-image-thumbs.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@gosilex/spark-feedback": "file:./packages/spark-feedback",
    "@libsql/client": "^0.18.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "nodemailer": "^9.1.1",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "resend": "^6.26.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.39",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  }
}
