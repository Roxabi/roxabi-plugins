{
  "name": "cf-chemin-a",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.json",
    "test": "turbo test",
    "test:coverage": "bash scripts/kit/test-coverage.sh",
    "test:e2e:design-system": "bun run --filter @kit/example-web test:e2e:design-system",
    "test:e2e:ci": "bash scripts/kit/e2e-ci.sh",
    "test:assertledger": "node scripts/kit/assertledger/smoke.mjs",
    "test:assertledger-adapter": "node scripts/kit/assertledger/selftest.mjs",
    "db:migrate": "bun run --filter @kit/example-api db:migrate",
    "db:seed": "bun run --filter @kit/example-api db:seed",
    "db:seed:reset": "bun run --filter @kit/example-api db:seed:reset",
    "db:reset": "bun run --filter @kit/example-api db:reset",
    "extract-dry-run": "bash scripts/kit/extract-dry-run.sh",
    "banlist": "bash scripts/kit/check-banned-strings.sh",
    "zod-major": "bash scripts/kit/check-zod-major.sh",
    "ts-major": "bash scripts/kit/check-typescript-major.sh",
    "test:ts-major": "bash scripts/kit/test-typescript-major.sh",
    "zero-edit": "bash scripts/kit/check-zero-edit-zones.sh",
    "import-boundary": "bun run scripts/kit/check-import-boundaries.ts",
    "test:import-boundary": "bash scripts/kit/test-import-boundaries.sh",
    "tsconfig-orphans:check": "bun run scripts/kit/check-tsconfig-orphans.ts",
    "test:tsconfig-orphans": "bash scripts/kit/test-tsconfig-orphans.sh",
    "debt:check": "bun run scripts/kit/check-debt.ts",
    "test:debt": "bash scripts/kit/test-debt.sh",
    "folder-size:check": "bash scripts/kit/check_folder_size.sh",
    "test:folder-size": "bash scripts/kit/test-folder-size.sh",
    "agents-adr:check": "bash scripts/kit/check-agents-adr-hygiene.sh",
    "doc:check": "bun run scripts/kit/check-doc-hygiene.ts",
    "test:doc-hygiene": "bash scripts/kit/test-doc-hygiene.sh",
    "bun-version:check": "bun run scripts/kit/check-bun-version.ts",
    "test:bun-version": "bash scripts/kit/test-bun-version.sh",
    "stack-contract:check": "bun run scripts/kit/check-stack-contract.ts",
    "test:stack-contract": "bash scripts/kit/test-stack-contract.sh",
    "actions-pin:check": "bun run scripts/kit/check-actions-pin.ts",
    "test:actions-pin": "bash scripts/kit/test-actions-pin.sh",
    "env:check": "bun run scripts/kit/check-env-sync.ts",
    "i18n:check": "bun run --filter @kit/example-web test -- src/messages/messages.contract.test.ts",
    "license:check": "bun run scripts/kit/licenseChecker.ts",
    "knip": "knip",
    "test:biome-strict": "bash scripts/kit/test-biome-strict.sh",
    "quality-gates:check": "env -u QG_FILE_EXEMPTIONS -u QG_FILE_MAX -u QG_FILE_ROOTS -u QG_FILE_PRODUCT_EXEMPTIONS QG_FILE_MODE=tree bash scripts/kit/check_file_length.sh && env -u QG_FOLDER_EXEMPTIONS -u QG_FOLDER_MAX -u QG_FOLDER_ROOTS -u QG_FOLDER_PRODUCT_EXEMPTIONS bash scripts/kit/check_folder_size.sh",
    "validate": "bun run lint && bun run typecheck && bun run typecheck:tooling && bun run test && bun run banlist && bun run zod-major && bun run ts-major && bun run extract-dry-run && bun run zero-edit && bun run env:check && bun run wrangler-migrations:check",
    "build:kit": "turbo run build --filter=@kit/example-api --filter=@kit/example-web",
    "cf:showcase:install": "bash scripts/kit/cf-builds/install-monorepo.sh",
    "cf:showcase:deploy-api": "bash scripts/kit/cf-builds/api-deploy.sh",
    "cf:showcase:build-web": "bash scripts/kit/cf-builds/web-build.sh",
    "test:cf-builds": "bash scripts/kit/test-cf-builds.sh",
    "smoke:mcp": "bun run --filter @kit/mcp-example smoke:stdio",
    "validate:full": "bun run lint && bun run typecheck && bun run typecheck:tooling && bun run banlist && bun run zod-major && bun run ts-major && bun run test:ts-major && bun run extract-dry-run && bun run test:extract-dry-run && bun run zero-edit && bun run import-boundary && bun run test:import-boundary && bun run tsconfig-orphans:check && bun run test:tsconfig-orphans && bun run test:deny-upstream && bun run test:lefthook-deletes && bun run test:semctx-working-empty && bun run test:trufflehog-pin && bun run test:promote-deploy && bun run migrations-contract:check && bun run test:migrations-contract && bun run test:file-length && bun run test:folder-size && bun run test:dogfood-zero-edit && bun run test:kit-schema-sync && bun run check:bar-ssot && bun run test:bar-ssot && bun run test:falsify && bun run test:assertledger-adapter && bun run wrangler-migrations:check && bun run test:wrangler-migrations && bun run test:cf-builds && bun run debt:check && bun run test:debt && bun run agents-adr:check && bun run openapi:check && bun run doc:check && bun run test:doc-hygiene && bun run bun-version:check && bun run test:bun-version && bun run stack-contract:check && bun run test:stack-contract && bun run actions-pin:check && bun run test:actions-pin && bun run env:check && bun run test:coverage && bun run license:check && bun run quality-gates:check && bun run build:kit && bun run smoke:mcp && bun run knip && bun run test:biome-strict",
    "prepare": "git config --get core.hooksPath >/dev/null 2>&1 || lefthook install",
    "dogfood:zero-edit": "bash scripts/kit/dogfood-zero-edit.sh --self-sim",
    "test:dogfood-zero-edit": "bash scripts/kit/dogfood-zero-edit.sh --self-sim",
    "test:deny-upstream": "bash scripts/kit/test-deny-upstream.sh",
    "test:file-length": "bash scripts/kit/test-file-length.sh",
    "test:kit-schema-sync": "bash scripts/kit/test-kit-schema-sync.sh",
    "check:bar-ssot": "bash scripts/kit/check-bar-ssot.sh",
    "test:bar-ssot": "bash scripts/kit/test-check-bar-ssot.sh",
    "test:falsify": "bash scripts/kit/test-falsify.sh",
    "wrangler-migrations:check": "bash scripts/kit/check-wrangler-migrations-dir.sh",
    "test:wrangler-migrations": "bash scripts/kit/test-wrangler-migrations-dir.sh",
    "test:lefthook-deletes": "bash scripts/kit/test-lefthook-deletes.sh",
    "check:semctx-working-empty": "bash scripts/kit/check-semctx-working-empty.sh",
    "test:semctx-working-empty": "bash scripts/kit/test-semctx-working-empty.sh",
    "test:trufflehog-pin": "bash scripts/kit/test-trufflehog-pin.sh",
    "migrations-contract:check": "bun run scripts/kit/check-migrations-contract.ts",
    "test:migrations-contract": "bash scripts/kit/test-migrations-contract.sh",
    "test:promote-deploy": "bash scripts/kit/test-promote-deploy.sh",
    "test:extract-dry-run": "bash scripts/kit/test-extract-dry-run.sh",
    "openapi": "bun run scripts/kit/gen-openapi.ts",
    "openapi:check": "bun run scripts/kit/gen-openapi.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "assertledger": "1.1.0",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "playwright-core": "^1.63.0",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "^8.3.0"
  }
}
