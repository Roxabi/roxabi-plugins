{
  "name": "roxabi-plugins",
  "version": "0.4.0",
  "private": true,
  "description": "Open-source Claude Code plugins by Roxabi",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "bunx biome check .",
    "typecheck": "tsc --noEmit",
    "build": "bun run tools/build-omp-build-contracts.ts",
    "verify:omp-build-distribution": "bun run tools/verify-omp-build-distribution.ts",
    "quality:omp-build": "bun tools/check-omp-build-quality.ts --with-biome",
    "verify:pins": "bun run tools/verify-action-pins.ts"
  },
  "devDependencies": {
    "@babel/parser": "8.0.8",
    "@babel/types": "8.0.8",
    "@oh-my-pi/pi-coding-agent": "18.12.6",
    "@oh-my-pi/pi-ai": "18.12.6",
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "bun-types": "^1.4.4",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.2",
    "vitest": "^5.0.5",
    "zod": "4.6.7"
  }
}
