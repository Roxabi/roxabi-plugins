# .dev/stack.yml — dev-core stack configuration (example / reference template)
# COMMIT the real `.dev/stack.yml` — it declares project stack conventions
# (paths, commands, formatter, test runner), and dev-core/CI read release.model +
# release.component from it. No secrets go here; only `.env` stays gitignored.
# `.dev/dev-core.yml` holds GitHub Project node IDs (public, not secrets) — commit it too.
# Copy this file to `.dev/stack.yml` and adjust for a fresh clone.
schema_version: "1.0"

runtime: bun
package_manager: bun

backend:
  framework: none
  path: ""

frontend:
  framework: none
  path: ""

shared: {}

build:
  orchestrator: none
  formatter: biome
  formatter_config: biome.json
  formatter_fix_cmd: "bunx biome check --write"

testing:
  unit: vitest
  e2e: none

hooks:
  tool: lefthook

deploy:
  platform: none

docs:
  framework: none
  path: docs
  format: md

commands:
  dev: ""
  build: ""
  test: bun run test
  lint: bun run lint
  typecheck: bun run typecheck
  format: "bunx biome check --write"
  install: bun install

# /dev-review roster — deterministic oracle (plugins/dev-core/skills/dev-review/roster.sh).
# The cap is total agents per chunk, including the R-adversarial floor. Overrides are
# optional and list active roles only: `always` bypasses a gate, `never` suppresses it,
# and the floor ignores `never`.
review:
  roster:
    max_agents: 3                 # R-adversarial + at most 2 specialists per chunk
    agents:                       # per-agent override: default | always | never
      R-adversarial: default      # immutable floor
      R-security-auditor: default # security path signals
      R-tester: default           # test delta ∧ oracle_ok=false; after dominant domain
      R-frontend-dev: default     # configured FE/shared-UI path, else FE extension
      R-backend-dev: default      # configured backend path
      R-devops: default           # infra path signal, independent of tier
      R-architect: default        # axial mode or conservative structural signal

artifacts:
  brainstorms: artifacts/brainstorms
  analyses: artifacts/analyses
  specs: artifacts/specs
  frames: artifacts/frames
  plans: artifacts/plans
