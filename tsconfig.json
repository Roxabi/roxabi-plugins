{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "vitest.config.ts",
    "vitest.setup.ts",
    "vitest.global-setup.ts",
    "vitest.integration.global-setup.ts",
    "vitest.integration.setup.ts",
    "plugins/issue-triage/**/*.ts",
    "plugins/omp-build/**/*.ts",
    "tools/**/*omp-build*.ts",
    "tools/**/*omp-build*/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "plugins/issue-triage/skills/issue-triage/triage.ts",
    "plugins/omp-build/dist/issue-triage/skills/issue-triage/triage.ts"
  ]
}
